__pycache__/
*.pyc
.venv/
.env
node_modules/
dist/
.DS_Store

# The SQLite database is generated by `alembic upgrade head` + `seed.py`, so it
# is rebuildable and must never be committed — it would otherwise ship whatever
# script content the last developer happened to be editing.
# -wal and -shm are the write-ahead log and shared-memory files SQLite creates
# alongside it.
*.db
*.db-wal
*.db-shm
