# Every value here already has a working default in app/config.py — this file
# documents what is tunable, it is not required. Copy to `.env` only if you
# want to change something.

# Where the SQLite file lives. Defaults to backend/scriptbuilder.db, resolved
# from the package directory rather than the current working directory, so it
# does not matter where you launch uvicorn or alembic from.
# DATABASE_URL=sqlite:///./scriptbuilder.db

# Log every SQL statement to stdout. Useful when tracing a query, very noisy.
# DATABASE_ECHO=false

# Comma-separated origins allowed to call the API. The default matches Vite's
# dev server; add the deployed frontend origin here in production.
CORS_ORIGINS=http://localhost:5173
