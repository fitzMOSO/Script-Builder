# Keep the build context small and, more importantly, keep host-built artefacts
# out of the image — a Windows .venv or a locally-built dist/ copied into a
# Linux container is at best dead weight and at worst broken binaries.
.git
.github
.vscode
.remember
node_modules
**/node_modules
.venv
**/.venv
__pycache__
**/__pycache__
*.pyc

# Built by stage 1 inside the image, never copied from the host.
frontend/dist

# The database is created by `alembic upgrade head` at boot.
*.db
*.db-wal
*.db-shm

# Never bake a local .env into an image; Render supplies environment variables.
.env
**/.env

docs
LAUNCH.md
README.md
LICENSE
